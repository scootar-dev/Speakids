# ============================================
# SpeaKids .gitignore
# ============================================

# Flutter / Dart build artifacts
.dart_tool/
build/
android/.gradle/
android/.kotlin/
android/app/build/

# Local configuration, model weights and Python environments
**/.env
**/.env.local
**/.venv/
**/__pycache__/
**/.pytest_cache/
pronunciation_backend/model_cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.iml

# Distribution output (generated by CI)
dist/
