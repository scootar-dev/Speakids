# No secrets belong in Flutter. Production verifies a short-lived end-user JWT.
DEV_NO_AUTH=false
JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
JWT_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=authenticated
CORS_ORIGINS=https://your-student-site.example,https://appassets.androidplatform.net
MODEL_PATH=/models/phoneme
MODEL_DEVICE=cpu
MODEL_ALLOW_PICKLE=false
# Windows eSpeak NG installation (set only on Windows):
# PHONEMIZER_ESPEAK_LIBRARY=C:\Program Files\eSpeak NG\libespeak-ng.dll
MODEL_VERSION=speakids-ctc-research-v1
